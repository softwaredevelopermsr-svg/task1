<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="custom_ledger_extension.ReportLoading"
       t-inherit="account_reports.AccountReportCustomizable"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_content')]" position="attributes">
            <attribute name="class" add="cle_report_loading_container" separator=" "/>
            <attribute name="t-att-aria-busy">controller.cleReportBusy ? 'true' : 'false'</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_content')]" position="inside">
            <div t-if="controller.cleReportBusy"
                 class="cle_report_loading_overlay d-print-none">
                <div class="cle_report_loading_message shadow-sm" role="status" aria-live="polite" aria-atomic="true">
                    <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"/>
                    <span>Updating report…</span>
                </div>
            </div>
        </xpath>
    </t>
</templates>
